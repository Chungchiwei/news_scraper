  "incident_subtype_priority_order": ["VESSEL_ATTACK", "SINKING", "HIJACKING", "EXPLOSION", "FIRE", "GROUNDING", "ALLISION", "LOSS_OF_PROPULSION", "STOWAWAY_DRUGS", "CREW_CASUALTY", "POLLUTION", "PORT_DISRUPTION", "COLLISION"],

  "source_family_patterns": {
    "_comment": "Phase 2.1 §十四：deterministic 轉載偵測。不做 NLP，只比對『according to X / X reported / via X / reported by X』這類固定句型，用來把『同一手消息的多次轉載』收斂成 1 個 independent source。",
    "REUTERS":   {"aliases": ["reuters"],   "repost_patterns": ["according to reuters", "reuters reported", "via reuters", "reported by reuters", "reuters news agency reported"]},
    "AP":        {"aliases": ["ap", "associated press"], "repost_patterns": ["according to ap", "the associated press reported", "via ap", "reported by the associated press", "ap reported"]},
    "AFP":       {"aliases": ["afp", "agence france-presse"], "repost_patterns": ["according to afp", "afp reported", "via afp", "reported by afp"]},
    "BLOOMBERG": {"aliases": ["bloomberg"], "repost_patterns": ["according to bloomberg", "bloomberg reported", "via bloomberg", "reported by bloomberg"]},
    "XINHUA":    {"aliases": ["xinhua", "新華社", "新华社"], "repost_patterns": ["according to xinhua", "xinhua reported", "新華社報導", "新华社报道"]}
  },

  "ssl": {
    "_comment": "Phase 2.1 §十八〜二十一：預設一律驗證憑證。只有在個別來源的 sources config 明確加上 verify_ssl:false 時才關閉，且必須記錄 WARNING log，不可全域關閉。",
    "default_verify": true
  },

  "legacy_category_to_event_type": {
    "CAT1": "SAFETY",
    "CAT2": "SAFETY",
    "CAT3": "SAFETY",
    "CAT4": "SECURITY",
    "CAT5": "CREW",
    "CAT6": "COMPETITOR",
    "OTHER": "OTHER"
  },

  "carrier_pr_filter": {
    "_comment": "只套用在 source_category == 航商動態 或 event_type == COMPETITOR 的文章。keep 命中 → 保留（視為 operational news）；沒 keep 但命中 exclude → 直接濾除；兩者都沒命中（不確定）→ 保留但降級（不自動升高 priority）。",
    "keep_keywords_en": ["new service", "new container service", "launches new service", "service suspension", "route change", "port omission", "blank sailing", "capacity deployment", "new vessel deployment", "alliance change", "schedule change", "surcharge", "freight rate", "container shortage", "terminal change", "canal diversion", "war risk", "port congestion", "acquisition", "merger", "fleet investment", "newbuilding order"],
    "keep_keywords_zh": ["新航線", "服務暫停", "航線調整", "跳港", "取消掛靠", "運力部署", "新船投入", "聯盟調整", "船期異動", "附加費", "運價", "貨櫃短缺", "碼頭異動", "運河改道", "戰爭險", "港口壅塞", "併購", "收購", "船隊投資", "新船訂單"],
    "exclude_keywords_en": ["award", "wins award", "esg", "sustainability award", "corporate event", "sponsorship", "sponsors", "csr", "employee", "staff story", "brand campaign", "conference", "interview", "celebrates", "anniversary", "partnership announcement"],
    "exclude_keywords_zh": ["獲獎", "得獎", "永續獎", "企業社會責任", "贊助", "員工", "品牌活動", "研討會", "專訪", "週年", "夥伴關係宣布", "慶祝"]
  },

  "clustering": {
    "_comment": "Phase 2.1 §三/四：加入 negative/conflict signals，不再只累加 positive score。Strong Identifier 優先順序：vessel_name > IMO(未來) > carrier+event_type+location > time proximity > title similarity > summary similarity。",
    "time_window_hours": 48,
    "cluster_score_threshold": 50,
    "title_similarity_high_cutoff": 0.75,
    "summary_similarity_high_cutoff": 0.5,
    "hard_reject_score": -9999,
    "weights": {
      "same_vessel_name": 50,
      "same_carrier": 15,
      "same_event_type": 15,
      "different_event_type": -10,
      "same_incident_subtype": 30,
      "different_incident_subtype": -35,
      "different_vessel_type": -70,
      "same_location": 15,
      "same_major_sea_area": 10,
      "related_region_group": 12,
      "title_similarity_high": 20,
      "summary_similarity_high": 15,
      "time_proximity_close_bonus": 10,
      "time_proximity_close_hours": 6
    }
  },

  "confidence_level_rules": {
    "high_requires": "tier_a_present OR 2_plus_independent_tier_b",
    "medium_requires": "1_tier_b OR 2_plus_tier_c",
    "low_fallback": "tier_d_only_or_no_cross_validation",
    "_note": "以上全部改用 independent_source_tiers（已排除轉載）計算，不是 raw article 計數，見 §十二/十五。"
  },

  "information_status_rules": {
    "_comment": "Phase 2.1 §六：與 management_priority 完全獨立計算，用 independent_source_tiers 判斷。",
    "confirmed_requires": "tier_a_present",
    "corroborated_requires": "2_plus_independent_tier_b",
    "unconfirmed_requires": "1_tier_b_or_tier_c",
    "early_signal_fallback": "tier_d_only"
  }
}
